<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="variables-window__non-runtime-panel" class="panel panel--center">
        <ui:Label text="Can&apos;t browse variables in editor mode" name="non-runtime-panel__header-label" />
        <ui:Label text="Enter Play mode to inspect values" name="non-runtime-panel__hint-label" />
    </ui:VisualElement>
    <ui:VisualElement name="variables-window__runtime-panel" class="panel">
        <ui:DropdownField label="Variable type" name="runtime-panel__type-dropdown" class="type-dropdown" />
        <ui:ScrollView name="runtime-panel__record-container" />
    </ui:VisualElement>
</ui:UXML>
